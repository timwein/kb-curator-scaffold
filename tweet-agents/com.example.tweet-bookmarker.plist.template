<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Replace <YOUR-LABEL> with your own reverse-DNS label, e.g.
         com.yourname.tweet-bookmarker. Replace <PATH-TO-CHECKOUT> with the
         absolute path to your tweet-agents checkout. Replace the two secret
         values with your own. DO NOT commit a filled-in plist — it contains
         credentials.

         `make_launchd.py` generates a filled-in copy of this template for you
         and writes it to ~/Library/LaunchAgents/. -->

    <key>Label</key>
    <string><YOUR-LABEL></string>

    <key>ProgramArguments</key>
    <array>
        <string><PATH-TO-CHECKOUT>/.venv/bin/python</string>
        <string><PATH-TO-CHECKOUT>/run_bookmarker.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string><PATH-TO-CHECKOUT></string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ANTHROPIC_API_KEY</key>
        <string>sk-ant-...</string>
        <key>GITHUB_PAT</key>
        <string>github_pat_...</string>
        <!-- A GitHub-verified email on your account. Used as the committer
             email so Vercel's committer-to-GitHub-user check passes. -->
        <key>GIT_COMMITTER_EMAIL</key>
        <string>you@example.com</string>
    </dict>

    <!-- Every 3 hours at :30, from 06:30 to 21:30 local time. 6 fires/day.
         Offset from :00 so we don't collide with the tweet-kb agent (which
         runs at 06:00 / 12:00 / 18:00 and holds the Chrome profile
         SingletonLock). Reduced from hourly (19/day) for cost. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/tweet-bookmarker.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tweet-bookmarker.log</string>

    <!-- Don't run on load — wait for the next scheduled fire. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
