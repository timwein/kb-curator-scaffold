# Copy to .env and fill in the two secrets below, then run scripts/setup.py
# (and scripts/podcast-setup.py for the podcast agent). Everything under
# "Populated by ..." is written back into .env automatically.

ANTHROPIC_API_KEY=sk-ant-...
GITHUB_PAT=github_pat_...

# The KB repo the agents write to (create an empty repo first).
KB_REPO_URL=https://github.com/<your-username>/<your-kb-repo>
KB_REPO_TOKEN=github_pat_...   # PAT with contents:write on the KB repo (can be the same as GITHUB_PAT)

# Optional: committer identity the agents use for KB pushes. Set the email to a
# GitHub-verified address if you deploy the reader (Vercel Hobby requirement).
# GIT_COMMITTER_EMAIL=you@example.com
# GIT_COMMITTER_NAME=kb-curator

# Optional: where your personalized seed files live (defaults to ./seed).
# Copy seed-templates/ to seed/, drop the EXAMPLE_ prefixes, and edit.
# SEED_DIR=./seed

# ---- Populated by scripts/setup.py (blog agent) ----
ENV_ID=env_...
AGENT_ID=agent_...
AGENT_VERSION=1
SEED_FILE_IDS=interests_seed.md:file_xxx,topic_taxonomy.md:file_yyy,...

# ---- Populated by scripts/podcast-setup.py (podcast agent) ----
PODCAST_ENV_ID=env_...
PODCAST_AGENT_ID=agent_...
PODCAST_AGENT_VERSION=1
